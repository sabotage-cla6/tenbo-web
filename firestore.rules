rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(tableId, userId) {
      return userId == null
        || exists(/databases/$(database)/documents/tables/$(tableId)/members/$(userId));
    }

    match /tables/{tableId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      // 卓IDを指定した単一ドキュメントの取得のみ許可する。
      allow get: if signedIn()
        && (resource == null
          || resource.data.ownerUid == request.auth.uid
          || resource.data.status == 'waiting'
          || exists(/databases/$(database)/documents/tables/$(tableId)/members/$(request.auth.uid)));

      // 卓の設定変更・削除はオーナーのみ。
      // 参加者登録に伴う memberCount / updatedAt の更新だけは、
      // 同じトランザクションで本人の参加者ドキュメントが新規作成される場合に許可する。
      allow update: if signedIn()
        && (
          (
            resource.data.ownerUid == request.auth.uid
            && resource.data.status == 'waiting'
            && request.resource.data.status == resource.data.status
          )
          || (
            resource.data.status == 'waiting'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['memberCount', 'updatedAt'])
            && request.resource.data.memberCount == resource.data.get('memberCount', 1) + 1
            && existsAfter(
              /databases/$(database)/documents/tables/$(tableId)/members/$(request.auth.uid)
            )
            && !exists(
              /databases/$(database)/documents/tables/$(tableId)/members/$(request.auth.uid)
            )
          )
          || (
            resource.data.status == 'waiting'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['seats', 'updatedAt'])
            && exists(
              /databases/$(database)/documents/tables/$(tableId)/members/$(request.auth.uid)
            )
            && request.resource.data.seats.keys().hasOnly(['east', 'south', 'west', 'north'])
            && (request.resource.data.seats.get('east', null) == request.auth.uid
              || request.resource.data.seats.get('south', null) == request.auth.uid
              || request.resource.data.seats.get('west', null) == request.auth.uid
              || request.resource.data.seats.get('north', null) == request.auth.uid)
            && isMember(tableId, request.resource.data.seats.get('east', null))
            && isMember(tableId, request.resource.data.seats.get('south', null))
            && isMember(tableId, request.resource.data.seats.get('west', null))
            && isMember(tableId, request.resource.data.seats.get('north', null))
            && (request.resource.data.seats.get('east', null) == null
              || request.resource.data.seats.get('south', null) == null
              || request.resource.data.seats.get('east', null)
                != request.resource.data.seats.get('south', null))
            && (request.resource.data.seats.get('east', null) == null
              || request.resource.data.seats.get('west', null) == null
              || request.resource.data.seats.get('east', null)
                != request.resource.data.seats.get('west', null))
            && (request.resource.data.seats.get('east', null) == null
              || request.resource.data.seats.get('north', null) == null
              || request.resource.data.seats.get('east', null)
                != request.resource.data.seats.get('north', null))
            && (request.resource.data.seats.get('south', null) == null
              || request.resource.data.seats.get('west', null) == null
              || request.resource.data.seats.get('south', null)
                != request.resource.data.seats.get('west', null))
            && (request.resource.data.seats.get('south', null) == null
              || request.resource.data.seats.get('north', null) == null
              || request.resource.data.seats.get('south', null)
                != request.resource.data.seats.get('north', null))
            && (request.resource.data.seats.get('west', null) == null
              || request.resource.data.seats.get('north', null) == null
              || request.resource.data.seats.get('west', null)
                != request.resource.data.seats.get('north', null))
            && (resource.data.playerCount != 3
              || request.resource.data.seats.get('north', null) == null)
          )
          || (
            // 対局開始は、着席済みの参加者が全席充足を確認して状態だけを変更する場合に許可。
            resource.data.status == 'waiting'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'game', 'updatedAt'])
            && request.resource.data.status == 'playing'
            && request.resource.data.game.round.wind == 'east'
            && request.resource.data.game.round.number == 1
            && request.resource.data.game.round.honba == 0
            && request.resource.data.game.round.seq == 1
            && request.resource.data.game.kyotakuSticks == 0
            && exists(/databases/$(database)/documents/tables/$(tableId)/members/$(request.auth.uid))
            && (
              request.resource.data.seats.get('east', null) == request.auth.uid
              || request.resource.data.seats.get('south', null) == request.auth.uid
              || request.resource.data.seats.get('west', null) == request.auth.uid
              || request.resource.data.seats.get('north', null) == request.auth.uid
            )
            && isMember(tableId, request.resource.data.seats.get('east', null))
            && isMember(tableId, request.resource.data.seats.get('south', null))
            && isMember(tableId, request.resource.data.seats.get('west', null))
            && isMember(tableId, request.resource.data.seats.get('north', null))
            && (
              (
                resource.data.playerCount == 3
                && request.resource.data.seats.get('east', null) != null
                && request.resource.data.seats.get('south', null) != null
                && request.resource.data.seats.get('west', null) != null
                && request.resource.data.seats.get('north', null) == null
                && request.resource.data.seats.east != request.resource.data.seats.south
                && request.resource.data.seats.east != request.resource.data.seats.west
                && request.resource.data.seats.south != request.resource.data.seats.west
              )
              || (
                resource.data.playerCount != 3
                && request.resource.data.seats.get('east', null) != null
                && request.resource.data.seats.get('south', null) != null
                && request.resource.data.seats.get('west', null) != null
                && request.resource.data.seats.get('north', null) != null
                && request.resource.data.seats.east != request.resource.data.seats.south
                && request.resource.data.seats.east != request.resource.data.seats.west
                && request.resource.data.seats.east != request.resource.data.seats.north
                && request.resource.data.seats.south != request.resource.data.seats.west
                && request.resource.data.seats.south != request.resource.data.seats.north
                && request.resource.data.seats.west != request.resource.data.seats.north
              )
            )
          )
          || (
            // リーチは本人の持ち点・リーチ状態・供託本数を同時に更新する。
            resource.data.status == 'playing'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['game', 'updatedAt'])
            && exists(/databases/$(database)/documents/tables/$(tableId)/members/$(request.auth.uid))
            && (
              resource.data.seats.get('east', null) == request.auth.uid
              || resource.data.seats.get('south', null) == request.auth.uid
              || resource.data.seats.get('west', null) == request.auth.uid
              || resource.data.seats.get('north', null) == request.auth.uid
            )
            && request.resource.data.game.diff(resource.data.game).affectedKeys().hasOnly(['players', 'kyotakuSticks'])
            && request.resource.data.game.players.diff(resource.data.game.players).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.game.players[request.auth.uid].diff(resource.data.game.players[request.auth.uid]).affectedKeys().hasOnly(['score', 'isRiichi'])
            && resource.data.game.players[request.auth.uid].isRiichi == false
            && request.resource.data.game.players[request.auth.uid].isRiichi == true
            && request.resource.data.game.players[request.auth.uid].score == resource.data.game.players[request.auth.uid].score - 1000
            && resource.data.game.players[request.auth.uid].score >= 1000
            && request.resource.data.game.kyotakuSticks == resource.data.game.kyotakuSticks + 1
          )
        );
      allow delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;

      match /members/{userId} {
        // 待機中ロビーの参加者一覧はログイン済みユーザーが取得できる。
        allow get, list: if signedIn()
          && (
            get(/databases/$(database)/documents/tables/$(tableId)).data.status == 'waiting'
            || exists(/databases/$(database)/documents/tables/$(tableId)/members/$(request.auth.uid))
          );

        // 自分自身の参加情報だけを登録できる。
        // 卓作成時のオーナー情報は親卓と同じ batch で作成するため getAfter を使う。
        allow create: if signedIn()
          && request.auth.uid == userId
          && getAfter(/databases/$(database)/documents/tables/$(tableId)).data.status == 'waiting'
          && (
            // 卓作成時は、オーナー情報を親卓と同じ batch で登録する。
            (
              !exists(/databases/$(database)/documents/tables/$(tableId))
              && getAfter(/databases/$(database)/documents/tables/$(tableId)).data.ownerUid == request.auth.uid
            )
            // 既存卓への参加時は、親卓の参加人数も同時に1人増やす。
            || (
              exists(/databases/$(database)/documents/tables/$(tableId))
              && getAfter(/databases/$(database)/documents/tables/$(tableId)).data.memberCount
                == get(/databases/$(database)/documents/tables/$(tableId)).data.get('memberCount', 1) + 1
            )
          );

        // 参加情報の変更・削除は別機能として扱う。
        allow update, delete: if false;
      }
    }
  }
}
